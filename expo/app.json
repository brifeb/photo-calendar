{
  "expo": {
    "name": "Photo Calendar",
    "slug": "photo-calendar",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": ["android"],
    "userInterfaceStyle": "dark",
    "scheme": "photocalendar",
    "android": {
      "package": "com.brifeb.photocalendar.expo",
      "permissions": ["READ_MEDIA_IMAGES", "READ_MEDIA_VISUAL_USER_SELECTED", "READ_EXTERNAL_STORAGE"]
    },
    "plugins": ["expo-media-library", "./plugins/withStandaloneDebug"],
    "experiments": { "typedRoutes": false }
  }
}
